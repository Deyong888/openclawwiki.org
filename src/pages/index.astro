---
import Layout from '~/layouts/PageLayout.astro';

import HeroDeep from '~/components/home/HeroDeep.astro';
import StatsBar from '~/components/home/StatsBar.astro';
import GlassFeatures from '~/components/home/GlassFeatures.astro';
import QuickStart from '~/components/home/QuickStart.astro';
import ToolsGlass from '~/components/home/ToolsGlass.astro';
import GlassFaq from '~/components/home/GlassFaq.astro';
import CtaGlow from '~/components/home/CtaGlow.astro';
import TrafficBanner from '~/components/custom/TrafficBanner.astro';

const metadata = {
  title: 'OpenClaw Wiki — The Self-Hosted AI Assistant Guide',
  description:
    'OpenClaw is the open-source, self-hosted AI assistant that runs on your own hardware. Explore the 2.0 release, step-by-step guides, and free planning tools.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Suppress the light announcement bar so the deep hero reads cleanly -->
  <Fragment slot="announcement" />

  <div class="deep-scope">
    <HeroDeep />
    <StatsBar />
    <GlassFeatures />
    <QuickStart />
    <ToolsGlass />
    <GlassFaq />
    <CtaGlow />

    <div class="mx-auto max-w-6xl px-5 pb-10 sm:px-8">
      <TrafficBanner variant="footer" site="all" />
    </div>
  </div>
</Layout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll<HTMLElement>('.deep-scope .reveal');

  if (reduce || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
    );
    items.forEach((el, i) => {
      // Stagger siblings slightly so groups cascade instead of popping.
      (el as HTMLElement).style.transitionDelay = `${Math.min(i % 6, 5) * 55}ms`;
      io.observe(el);
    });
  }
</script>

<noscript>
  <style>
    .deep-scope .reveal {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>
